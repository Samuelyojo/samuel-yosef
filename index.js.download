// Lesson 57 Calculator Program //

const display = document.getElementById("display");

function appenToDisplay(input){
    display.value += input;
}

function calculate(){
    try{
        display.value = eval(display.value)
    }catch(error){
        display.value = "Error";
    }
}

function clearDispaly(){
    display.value ="";
}

